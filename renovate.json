{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am every weekday"],
  "timezone": "Asia/Kolkata",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "patch updates",
      "automerge": true
    },
    {
      "description": "Group minor updates into a single PR",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates"
    },
    {
      "description": "Keep React and its types in sync",
      "matchPackageNames": ["react", "react-dom", "/^@types/react/"],
      "groupName": "react"
    },
    {
      "description": "Keep Tailwind CSS and its CLI in sync",
      "matchPackageNames": ["tailwindcss", "/^@tailwindcss//"],
      "groupName": "tailwind"
    },
    {
      "description": "Keep Bun in package.json and the workflows in sync",
      "matchPackageNames": ["bun", "oven-sh/setup-bun"],
      "groupName": "bun"
    }
  ]
}
